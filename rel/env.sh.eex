# esac

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive

# # Set the release to work across nodes.
# # RELEASE_DISTRIBUTION must be "sname" (local), "name" (distributed) or "none".
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=<%= @release.name %>@127.0.0.1
export RELEASE_COOKIE=mycookie
# # The game is configured in settings.txt at the game's root (generated on
# # first start): paths, ports, encodings, generic entities. Set a variable
# # here only to override a line of that file, for instance:
# export WORLDLETS_PATH=worldlets
# export PLUGINS_PATH=plugins
# export TELNET_PORT=4000
# # ... or to keep the game's files somewhere other than the release directory:
# export PYTHELIX_DIR=/path/to/pythelix/data
