@echo off
rem Set the release to load code on demand (interactive) instead of preloading (embedded).
rem set RELEASE_MODE=interactive

rem Set the release to work across nodes.
rem RELEASE_DISTRIBUTION must be sname (local), name (distributed) or none.
set RELEASE_DISTRIBUTION=name
set RELEASE_NODE=<%= @release.name %>@127.0.0.1
set RELEASE_COOKIE=mycookie

rem The game is configured in settings.txt at the game's root (generated on
rem first start): paths, ports, encodings, generic entities. Set a variable
rem here only to override a line of that file, for instance:
rem set WORLDLETS_PATH=worldlets
rem set PLUGINS_PATH=plugins
rem set TELNET_PORT=4000
rem ... or to keep the game's files somewhere other than the release directory:
rem set PYTHELIX_DIR=C:\path\to\pythelix\data
